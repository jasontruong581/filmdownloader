# Every value is optional. Copy to .env and set only what you need.

# Where finished media goes.
FILMDOWNLOADER_OUTPUT=output

# Durable state: the job database and settings.json. Kept separate from the
# media output directory, because this is what names that directory.
FILMDOWNLOADER_STATE=data

# Temporary working files (partial downloads, frame extraction).
FILMDOWNLOADER_SCRATCH=data/tmp

# Job database path. Defaults to <state>/jobs.db.
# FILMDOWNLOADER_DB=data/jobs.db

# FFmpeg directory or executable. Set this when FFmpeg is not on PATH, which is
# common on Windows. `python main.py doctor` shows what was found and where.
# FILMDOWNLOADER_FFMPEG=C:\ffmpeg\bin

# Server bind. Loopback is the default and needs no token.
FILMDOWNLOADER_HOST=127.0.0.1
FILMDOWNLOADER_PORT=8756

# Required for any bind other than loopback: the API resolves operator-supplied
# URLs server-side and writes files to disk, so a reachable unauthenticated
# instance is both an SSRF and a disk-write primitive. The server refuses to
# start on a wider bind without one.
# FILMDOWNLOADER_TOKEN=
